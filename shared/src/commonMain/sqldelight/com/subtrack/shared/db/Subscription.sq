-- anchorEpochDay é a PRIMEIRA cobrança e é a fonte da verdade. A próxima
-- renovação não é persistida: é calculada a partir da âncora (ver
-- NextRenewal.kt). Guardar "próxima renovação" no banco criaria um valor que
-- envelhece sozinho — bastaria o app ficar meses sem abrir pra ficar errado.
-- A ordenação por próxima renovação é feita em memória; a carteira típica tem
-- dezenas de linhas, não milhares.
CREATE TABLE subscription (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amountCents INTEGER NOT NULL,
    currency TEXT NOT NULL,
    cycle TEXT NOT NULL,
    cycleEveryN INTEGER NOT NULL DEFAULT 1,
    anchorEpochDay INTEGER NOT NULL,
    category TEXT,
    notifyDaysBefore INTEGER NOT NULL DEFAULT 3,
    archived INTEGER NOT NULL DEFAULT 0
);

selectActive:
SELECT * FROM subscription WHERE archived = 0;

selectAll:
SELECT * FROM subscription;

selectById:
SELECT * FROM subscription WHERE id = ?;

insert:
INSERT INTO subscription (name, amountCents, currency, cycle, cycleEveryN, anchorEpochDay, category, notifyDaysBefore, archived)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE subscription
SET name = ?, amountCents = ?, currency = ?, cycle = ?, cycleEveryN = ?, anchorEpochDay = ?, category = ?, notifyDaysBefore = ?, archived = ?
WHERE id = ?;

lastInsertedId:
SELECT last_insert_rowid();

setArchived:
UPDATE subscription SET archived = ? WHERE id = ?;

deleteById:
DELETE FROM subscription WHERE id = ?;
