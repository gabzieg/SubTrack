CREATE TABLE subscription (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amountCents INTEGER NOT NULL,
    currency TEXT NOT NULL,
    cycle TEXT NOT NULL,
    cycleEveryN INTEGER NOT NULL DEFAULT 1,
    nextRenewalEpochDay INTEGER NOT NULL,
    category TEXT,
    notifyDaysBefore INTEGER NOT NULL DEFAULT 3,
    archived INTEGER NOT NULL DEFAULT 0
);

selectActive:
SELECT * FROM subscription WHERE archived = 0 ORDER BY nextRenewalEpochDay ASC;

selectAll:
SELECT * FROM subscription ORDER BY nextRenewalEpochDay ASC;

selectById:
SELECT * FROM subscription WHERE id = ?;

insert:
INSERT INTO subscription (name, amountCents, currency, cycle, cycleEveryN, nextRenewalEpochDay, category, notifyDaysBefore, archived)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE subscription
SET name = ?, amountCents = ?, currency = ?, cycle = ?, cycleEveryN = ?, nextRenewalEpochDay = ?, category = ?, notifyDaysBefore = ?, archived = ?
WHERE id = ?;

setArchived:
UPDATE subscription SET archived = ? WHERE id = ?;

deleteById:
DELETE FROM subscription WHERE id = ?;
