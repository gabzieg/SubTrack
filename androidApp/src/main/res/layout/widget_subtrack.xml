<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews, não Compose/Glance: o conteúdo é texto puro, e Glance seria uma
  dependência nova com matriz de compatibilidade própria pra pouco ganho.
  Widget roda no processo do launcher, então só o subconjunto de Views que o
  RemoteViews aceita funciona aqui.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_total_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#B8C7D9"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
