<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:initialLayout="@layout/widget_subtrack"
    android:previewLayout="@layout/widget_subtrack"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:updatePeriodMillis="0" />
<!--
  updatePeriodMillis=0 de propósito: o sistema acordaria o aparelho num
  intervalo fixo (mínimo de 30min) pra atualizar um texto que muda uma vez por
  dia. Em vez disso o widget é atualizado por quem sabe que algo mudou — o
  worker diário de lembretes e as edições feitas no app.
-->
